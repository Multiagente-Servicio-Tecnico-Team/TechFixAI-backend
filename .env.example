GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CURRENCY=PEN
LABOR_MAINTENANCE_PRICE=35.00
LABOR_DIAGNOSIS_PRICE=50.00
LABOR_PC_BUILD_PRICE=50.00
DATABASE_URL=postgresql+pg8000://USER:PASSWORD@HOST:5432/DATABASE

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="agente-tecnico-langsmith"
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

TEST_EMAIL_TO=

# API de cuentas (registro e inicio de sesión)
# DATABASE_URL de ejemplo: postgresql+pg8000://postgres:CLAVE@localhost:5432/techfix
AUTH_SECRET=
AUTH_SECURE_COOKIE=false
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
BCRYPT_ROUNDS=12
# Audio se mantiene desactivado hasta habilitarlo explícitamente.
AUDIO_TRANSCRIPTION_ENABLED=false
AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=30
AUDIO_MAX_BYTES=25000000
AUDIO_MAX_DURATION_MS=120000
AUDIO_REQUESTS_PER_MINUTE=10
# Recuperación de contraseña: smtp usa las variables SMTP_*; outbox guarda los correos en OUTBOX_DIR
FRONTEND_URL=http://localhost:5174
MAIL_MODE=outbox
RESET_TOKEN_MINUTES=15
OUTBOX_DIR=.local/outbox
